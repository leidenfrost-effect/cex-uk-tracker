# Neon Postgres connection string (Vercel and GitHub Actions)
DB_DRIVER=neon
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Clerk Google authentication and cross-device collection synchronization
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Vercel-only secrets used by the admin refresh endpoint
ADMIN_REFRESH_SECRET=replace-with-a-long-random-password
GITHUB_ACTIONS_TOKEN=github_pat_with_actions_write_permission
GITHUB_REPOSITORY=leidenfrost-effect/cex-uk-tracker
GITHUB_WORKFLOW_FILE=daily-price-tracker.yml
GITHUB_DEFAULT_BRANCH=main
